# freebuff-proxy minimal env — 7 essential keys (see .env.example for the full set).
AUTH_TOKENS= # upstream token, empty = bridge mode
SAFE_MODE=true # anti-ban preset, leave ON
COST_MODE=free # must be free, anything else bills paid
LISTEN_ADDR=127.0.0.1:3457 # loopback default, :3457 for LAN/Docker
ADMIN_TOKEN=123456 # change before exposing the port
LOG_LEVEL=info # debug | info | warn | error
