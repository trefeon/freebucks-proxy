# freebucks-proxy systemd unit — run the bridge as a dedicated service user on
# the same host as 9router (see docs/9router-integration.md §1).
#
# One-time provisioning (Ubuntu/Debian):
#   sudo useradd --system --home-dir /var/lib/freebucks-proxy --shell /usr/sbin/nologin freebucks-proxy
#   sudo mkdir -p /etc/freebucks-proxy
#   sudo install -m 640 -o root -g freebucks-proxy .env /etc/freebucks-proxy/env
#   sudo install -m 0755 freebucks-proxy /usr/local/bin/freebucks-proxy
#
# StateDirectory=freebucks-proxy auto-creates /var/lib/freebucks-proxy owned by
# the service user at start. The app auto-loads .env from the working
# directory, and the dashboard persists .env edits there (ReadWritePaths).
#
# Install:
#   sudo cp scripts/freebucks-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now freebucks-proxy

[Unit]
Description=FreeBucks Proxy Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freebucks-proxy
Group=freebucks-proxy
WorkingDirectory=/var/lib/freebucks-proxy
StateDirectory=freebucks-proxy
EnvironmentFile=/etc/freebucks-proxy/env
ExecStart=/usr/local/bin/freebucks-proxy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Dashboard .env writes live in the working dir; self-update swaps the binary
# in place. Keep exactly these two trees writable despite ProtectSystem=strict.
ReadWritePaths=/var/lib/freebucks-proxy /usr/local/bin

[Install]
WantedBy=multi-user.target
