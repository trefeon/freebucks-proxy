# freebucks-proxy — ready-to-use, safest configuration for new users
#
# Copy this file to .env and start the proxy. Every value below is the
# SAFEST recommended default: anti-ban stealth on, loopback-only bind,
# rate limits respected, no secrets committed. You only need to decide
# one thing: pooled mode (AUTH_TOKENS) or bridge mode (leave empty).
#
#   cp .env.example .env
#   task dev                    # or: docker compose up -d --build
#
# Get your token with scripts/gen-token.sh (or scripts/gen-token.ps1).

# ── Mode (the only real decision) ─────────────────────────────────────────
# Comma-separated upstream token(s). EMPTY = bridge mode:
# the proxy stores no tokens; each client sends its own in
# Authorization: Bearer <token>. Pooled mode (tokens listed here) is best
# for one user with several accounts.
AUTH_TOKENS=

# ── Account safety (anti-ban) ────────────────────────────────────────────
# SAFE_MODE=true applies the anti-ban preset when a knob is left unset:
# idle-run rotation 30m, request jitter 200ms. TLS is CLI-faithful
# (plain Go/Bun baseline, no browser JA3) — set TLS_FINGERPRINT=auto
# only for browser-evasion on datacenter IPs (e.g. SG). Keep this ON.
# Set SAFE_MODE=false only if you understand the tradeoffs.
#
# Egress impersonates the official upstream CLI: ads requests carry the
# Freebuff-CLI/<vendored CLI version> User-Agent with the vendor's Chrome
# body UA, chat requests the ai-sdk UA, and session/auth endpoints a plain
# Bun/1.3.14 — plus your real timezone/locale. TLS is plain Go (CLI
# baseline) unless overridden below.
SAFE_MODE=true

# TLS fingerprint for upstream egress: empty = plain Go/Bun baseline,
# CLI-faithful (default). Set to auto/chrome126/safari18/... only for
# browser JA3 evasion on datacenter IPs (SG).
#TLS_FINGERPRINT=
# Random delay in [0, REQUEST_JITTER) before each upstream chat call —
# makes egress look like a human, not a bot. 200ms under SAFE_MODE; 0 disables.
# For absolute lowest TTFB set REQUEST_JITTER=0 (instant) — 200ms keeps light
# anti-ban jitter while saving ~1.8s avg vs the old 2s.
REQUEST_JITTER=200ms
# Pause run rotation / session refresh after this idle period (upstream
# only sees activity while you actually use the proxy). 30m under SAFE_MODE;
# 0 disables.
IDLE_ROTATION_TIMEOUT=30m

# Max additional attempts after a transient transport failure (TLS/conn/EOF/
# timeout). Never retries 429/403/401. 1 = safe default; 0 disables.
TRANSIENT_RETRIES=1

# Negotiate HTTP/2 with the upstream (#51): real browsers advertise
# "h2,http/1.1", so forcing HTTP/1.1 at the TLS layer is a JA4 ALPN mismatch.
# false forces HTTP/1.1 (escape hatch for non-h2 upstreams).
#HTTP2_UPSTREAM=true

# Persist upstream session state to disk so a restart resumes an unexpired
# session instead of burning a fresh daily session slot. ON BY DEFAULT
# (SESSION_PERSIST=true): the session instance id + expiry AND the active
# agent runs (run id, agent, trace id) are written to SESSION_STATE_FILE
# (0600) keyed by a SHA-256 hash of your token — the raw token is never
# written. A restart adopts the persisted session + runs without
# re-creating them. Set SESSION_PERSIST=false to opt out (each restart
# then burns a fresh daily admission slot).
#SESSION_PERSIST=true
#SESSION_STATE_FILE=.freebuff-session-state.json
# Docker note: the compose file mounts the project directory at the process
# cwd, so this state file persists across container recreates. Only a
# custom deployment that skips the mount needs a volume to keep it.

# ── Session lifecycle tuning ─────────────────────────────────────────────
# Re-admit a session pre-emptively when less than this much time remains.
# The rotation only starts while the account's seat is idle (upstream keeps
# one session per account, so a fresh admission would supersede any turn
# still in flight); when a turn holds the seat the re-admit defers and the
# session keeps serving through its expiry and its grace drain. The request
# that trips the re-admit is served by the fresh session.
#SESSION_RE_ADMIT_LEAD=60s
# Reuse the last successful session state (skip redundant session poll GETs)
# within this window after a successful admission/poll.
#SESSION_PROBE_CACHE_TTL=15s
# IANA zone the gateway declares on every session call (x-fb-timezone): the
# upstream server derives the account's daily reset zone from it. Empty = auto:
# the host zone when it is a real non-UTC zone, else the zone of the region the
# gateway actually egresses from (detected), else UTC. An invalid value falls
# back to auto with a warning.
#SESSION_TIMEZONE=

# ── Run lifecycle tuning ─────────────────────────────────────────────────
# Bounded deferred-FINISH worker queue: rotated/drained runs are FINISHed
# by a background worker; when the queue is full the caller falls back to a
# synchronous FINISH bounded by RUN_FINISH_INLINE_TIMEOUT.
#RUN_FINISH_QUEUE_SIZE=64
#RUN_FINISH_INLINE_TIMEOUT=250ms
# Bound the draining-runs list: entries older than RUNS_DRAIN_TTL or beyond
# RUNS_DRAIN_QUEUE_CAP are force-dropped (their upstream FINISH is
# best-effort anyway).
#RUNS_DRAIN_QUEUE_CAP=64
#RUNS_DRAIN_TTL=10m

# ── Cost safety ──────────────────────────────────────────────────────────
# MUST stay "free": any other value routes requests as PAID and fresh free
# accounts get 402 "Out of credits". Do not change this.
COST_MODE=free

# Optional upstream account id: sent on every chat call as
# x-freebuff-acting-user-id. BAN RISK: the CLI sends the account's OWN id
# (derived from GET /api/v1/me), and the server honors the header only for
# the upstream web service account — any value other than the token's own
# account id impersonates another user. Only safe value: the token's own
# account id. (Pre-rename name USER_ID still works.) Leave empty to omit.
#ACTING_USER_ID=

# ── Client Rate Limiting ─────────────────────────────────────────────────
# Per-source-IP token bucket rate limiter to prevent bursts, duplicate retries,
# and tool spam from hammering upstream. Requests exceeding the limit receive
# local HTTP 429 + Retry-After header immediately (zero upstream traffic).
# RATE_LIMIT_PER_IP: sustained requests/second per IP (0 = disabled; e.g. 20)
# RATE_LIMIT_BURST: maximum burst capacity (0 = defaults to 2 * RATE_LIMIT_PER_IP)
#RATE_LIMIT_PER_IP=0
#RATE_LIMIT_BURST=0

# ── Listening / access ───────────────────────────────────────────────────
# Loopback by default — the proxy is only reachable from this machine.
# For a LAN/Docker container set LISTEN_ADDR=:3457 (all interfaces).
LISTEN_ADDR=127.0.0.1:3457

# HTTP read timeout for client request bodies (issue #331): raise it when
# clients sit across the world and upload large prompts/images slowly.
# 0 disables the timeout. Restart-only.
#HTTP_READ_TIMEOUT=60s

# Protect the admin dashboard + POST /admin/reload. Defaults to factory
# password "123456" (a startup warning prompts rotation). Change it before
# exposing the port. Leave empty ONLY on loopback-only single-user installs.
ADMIN_TOKEN=123456
# Dashboard session cookies adapt dynamically to the connection protocol:
# Secure: true when accessed via HTTPS (or reverse proxy with X-Forwarded-Proto: https),
# Secure: false over plain HTTP so self-hosted cloud VPS instances work out of the box.
# To force Secure cookies unconditionally even over plain HTTP:
#ADMIN_FORCE_SECURE_COOKIES=false

# ── HTTPS & Domain (optional Caddy reverse proxy) ─────────────────────────
# When running with `docker compose --profile https up -d`:
# Set your public domain name for automatic Let's Encrypt TLS certificates.
# If unset, defaults to localhost (self-signed).
#DOMAIN=proxy.example.com
# Optional email for Let's Encrypt renewal notifications:
#ACME_EMAIL=admin@example.com
# Optional client auth for the OpenAI-compatible endpoint. When set, only
# requests bearing one of these keys (Authorization: Bearer or x-api-key)
# are served; leave empty to skip client auth. Overlaps with bridge mode —
# see README "API_KEYS × bridge" before combining.
#API_KEYS=

# ── CLI token auto-discovery ─────────────────────────────────────────────
# When AUTH_TOKENS is empty, the proxy reads credentials from the official
# CLI login files (~/.config/manicode|codebuff/credentials.json). That can
# silently flip bridge mode to pooled mode. NOTE: this knob is ENV-ONLY —
# it cannot be set in .env (it controls whether .env is read at all).
# Export it in your shell / systemd / compose environment to disable:
#   export AUTO_DISCOVER_TOKEN=false

# ── Observability ────────────────────────────────────────────────────────
# Log level: debug | info | warn | error | trace (trace = wire-level bodies)
LOG_LEVEL=info
# Log format: text (key=value, colored) or json (one JSON object per line)
#LOG_FORMAT=text
# One `access` line per HTTP request; false disables (healthz/metrics/OPTIONS
# are rate-limited to 1/min regardless)
#LOG_ACCESS=true

# ── Optional extras (see .env.full-example for every key) ────────────────
# Upstream base URL (default https://www.codebuff.com)
#UPSTREAM_BASE_URL=https://www.codebuff.com
# Registry refresh cadence (model catalog)
#REGISTRY_REFRESH=6h
# Comma-separated model allowlist: when set, only these RESOLVED model ids
# are served — /v1/models lists only them, and chat/messages/responses for
# any other model return 404 model_not_found. Empty = all models allowed.
#MODELS_ALLOW=
# Per-slot model pins (PIN_MODEL): AUTH_TOKENS position to the single model
# id that slot may serve, e.g. "0:z-ai/glm-5.2;1:deepseek/deepseek-v4-flash".
# Requests for other models skip pinned slots without burning their quota.
# Slots without an entry serve any model. Empty = feature off. Applies live
# on reload; malformed values reject the config.
#PIN_MODEL=
# Streak maintenance: one nightly run in the 60 minutes before the
# Pacific-midnight reset touches every account live (admit → one minimal
# turn → release; Auto = cheapest served unmetered row). Accounts with
# client traffic since the last Pacific reset are skipped. Default ON;
# set MATURITY_ENABLED=false to disable all automated touches.
#MATURITY_ENABLED=true
#MATURITY_TOUCH_MODEL=auto
#MATURITY_TARGET_DAYS=7
# Quota auto-probe scheduler (ADR-0022): one session-less probe per token
# per Pacific day in the 2h window before its known quota reset. Default
# ON; set false to restore pre-scheduler behavior (manual probes only).
# Smart zero-cost quota prober: activity-triggered (lease grant, successful
# chat, 429 refusal) plus reset-instant (per-model ResetAt, remembered-429
# reset, upstream credits (wire fields: `freebucks*`) daily refill)
# session-less probes keep parked quota fresh. Default ON; set false to
# restore pre-scheduler behavior (manual probes only).
# SMART_PROBE_BACKOFF_MAX caps the 429-backoff doubling (default 30m;
# empty or non-positive falls back to 30m). Both apply live on reload.
#SMART_PROBE_ENABLED=true
#SMART_PROBE_BACKOFF_MAX=30m
# MASQ spill order: strict account index order (#1..#N) per model with
# per-(account, model) live-turn slots and a FIFO waiter queue.
# SLOTS_PER_ACCOUNT caps concurrent live turns per lane (default 3,
# 2 = the conservative posture, 1 = fully sequential; 0 = unlimited, no
# slot gating). QUEUE_WAIT bounds one parked wait
# (default 30s); QUEUE_DEPTH caps parked waiters per lane (default 16,
# 0 = spill at once when full). A full queue or an elapsed wait spills
# silently to the next account, bounded by MAX_SPILL_ACCOUNTS (default 0
# = unbounded index chain). The end of the chain surfaces the existing
# 429 shape - never a new error code. All five apply live on reload.
# BUNKER (strictest anti-ban): SLOTS_PER_ACCOUNT=1 - fully sequential
# turns per account-model lane, zero parallel fingerprint.
#SLOTS_PER_ACCOUNT=3
#QUEUE_WAIT=30s
#QUEUE_DEPTH=16
#MAX_SPILL_ACCOUNTS=0
# Cooldown tuning (all live-apply on reload, integer milliseconds,
	# zero-tolerant: unset/empty/non-positive falls back to the default):
	# auth-rejection default 30m, region block 15m, upstream-field ceiling
	# 7d, fanout/invalid-model/opaque 1m, load-shed 90s, peak-hours 30m.
	#COOLDOWN_DEFAULT_MS=1800000
	#COOLDOWN_COUNTRY_BLOCK_MS=900000
	#COOLDOWN_CEILING_MS=604800000
	#COOLDOWN_FANOUT_MS=60000
	#COOLDOWN_INVALID_MODEL_MS=60000
	#COOLDOWN_OPAQUE_MS=60000
	#COOLDOWN_LOADSHED_MS=90000
	#COOLDOWN_PEAK_HOURS_MS=1800000
	# ip_capped: re-admits per Pacific day before the midnight lock (3),
	# and the +/- re-admit jitter fraction (0.2 = 20%, mirrors the CLI).
	#COOLDOWN_IP_MAX_READMITS=3
	#COOLDOWN_IP_JITTER_RATIO=0.2
	# Session park (live-apply): short-cooldown sessions keep their row
	# and retry on backoff instead of dropping. At-or-below 15m parks,
	# never drops; fatal refusals (ban, spend-exhausted, endsTheSession)
	# stay terminal regardless. 15m country_block and 30m 401-invalid are
	# time-bound cooldowns, never permanent quarantine.
	#SESSION_PARK_ENABLED=true
	#SESSION_PARK_THRESHOLD_MS=900000
# Poll/probe/maturity backoff ceilings (live-apply, integer ms):
# session-poll failure cap 5m, maturity nightly-walk 429 pause 3m
# (smart-probe 429-doubling ceiling is SMART_PROBE_BACKOFF_MAX above).
	#SESSION_POLL_MAX_MS=300000
	#MATURITY_BACKOFF_MS=180000
# Redact-and-dump upstream traffic to ./dump/ (debugging only)
#DEBUG_DUMP=false

# ── Request translation tuneables (backend/internal/convert — env-only) ──────────
# NOTE: these three are read DIRECTLY from the process environment via
# os.Getenv at request time. In a native/binary install, export them in your
# shell / systemd unit / launchd plist — the binary does NOT export .env
# values to process env (a .env line alone is inert outside Docker). Under
# docker compose, .env is wired through `env_file` and IS exported.
#
# COMPRESS_PROMPT (default OFF; 1/true/yes/on enables): compress long message
# lists before translation — middle user/assistant turns beyond a trailing
# budget (keep last 10) are replaced by a single marker message, and content
# over 8 KiB on kept user/assistant turns is capped. Tool results, assistant
# tool_calls, system messages and the last message are never dropped.
#COMPRESS_PROMPT=false
# CACHE_CONTROL_INJECTION (default ON; 0/false/off/no/disabled disables):
# add {"type":"ephemeral"} cache_control to the stable DeepSeek context
# prefix (messages at indices 2-3) for prompt caching (#84).
#CACHE_CONTROL_INJECTION=true
# REASONING_IN_CONTENT (default OFF): fold reasoning_content into
# delta.content as "<tag>...</tag>" text for clients that never render a
# reasoning channel; the reasoning channel is preserved alongside, and
# reasoning_details is never folded. true/1/on — "think" tag; any other
# word becomes the tag.
#REASONING_IN_CONTENT=false
#
# ── Web UI ────────────────────────────────────────────────────────────────
# Enable the embedded admin dashboard at /admin. Set to false to disable
# all /admin routes (returns 404). The dashboard provides token management,
# config editing, log viewer, and metrics — recommended to keep enabled
# unless you're running headless.
#DASHBOARD_ENABLED=true
